# --- Database ---
DATABASE_URL=sqlite:///./uc3.db

# --- Model tiers (Design Doc Section 7.3) ---
# Tier 1 (cheap, routine docs): deepseek | local
# Tier 2 (escalation, low-confidence + agents): anthropic | local
TIER1_PROVIDER=local
TIER2_PROVIDER=local
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Auth ---
API_KEY=dev-local-key

# --- Thresholds ---
TIER1_ESCALATION_THRESHOLD=0.7
ENTITY_MATCH_CONFIDENT_THRESHOLD=0.85
ENTITY_MATCH_AMBIGUOUS_FLOOR=0.55
FLAG_REVIEW_THRESHOLD=0.75

# --- Run budget (Section 6: hard budgets, enforced by the Orchestrator) ---
RUN_TOKEN_BUDGET=200000
RUN_SPEND_BUDGET_USD=5.00

UPLOAD_DIR=./uploads
